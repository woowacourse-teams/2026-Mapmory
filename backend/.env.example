# Mapmory Backend 환경변수
#
# 운영: /etc/mapmory.env 에 값을 채워 넣는다 (systemd EnvironmentFile)
# 로컬: application-local.yaml 에 기본값이 있어 대부분 불필요
#
# ⚠️ 새 환경변수를 코드에 추가하면 이 파일도 함께 갱신한다.
#    이 파일이 배포자가 필요한 값을 알 수 있는 유일한 경로다.

# --- DB ---
DB_HOST=
DB_USER=
DB_PASSWORD=

# --- 인증 ---
# 32자 이상 필요. 짧으면 WeakKeyException 으로 기동 실패한다
# 생성: openssl rand -hex 32
JWT_SECRET=

# --- 애플리케이션 메타데이터 ---
# 운영 배포 시 Git commit SHA 또는 릴리스 버전으로 변경한다
APP_VERSION=unknown

# --- S3 ---
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# 공용 버킷에서 우리 객체를 모을 접두사. 전용 버킷이면 비워 둔다
# 운영은 우테코 공용 버킷을 쓰므로 mapmory 를 넣는다
AWS_S3_KEY_PREFIX=

# --- 장소 검색 ---
# Geoapify Address Autocomplete + Place Details API 키
GEOAPIFY_API_KEY=

# --- 랜딩 출시 알림 ---
# 쉼표로 구분한 정확한 랜딩 origin. 와일드카드는 사용하지 않는다.
WAITLIST_ALLOWED_ORIGINS=https://map-mory.com,https://www.map-mory.com
