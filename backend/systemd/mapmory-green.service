[Unit]
Description=Mapmory Green application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mapmory
EnvironmentFile=/etc/mapmory.env
EnvironmentFile=-/etc/mapmory-deployment-cache.env
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/mapmory/slots/green/current/mapmory-backend.jar --server.address=127.0.0.1 --server.port=8090 --management.server.address=127.0.0.1 --management.server.port=8091 --server.shutdown=graceful --spring.lifecycle.timeout-per-shutdown-phase=30s
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120s
SendSIGKILL=no
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
