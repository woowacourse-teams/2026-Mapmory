// Public native app identifier, shared by Debug, Internal and App Store builds.
// Never put tokens, admin keys or client secrets in this file.
MAPMORY_KAKAO_NATIVE_APP_KEY = a5125976d5b1e29e6319da61940dbfd7

// Backend audience: the existing Web OAuth client, NOT an Android/iOS client.
MAPMORY_GOOGLE_WEB_CLIENT_ID = 601411744421-fdic8ohcmsifv36dbpmk2shf0up1hplj.apps.googleusercontent.com

// Google Cloud must first issue an iOS OAuth client for com.mapmory.ios.
// Paste only the part BEFORE .apps.googleusercontent.com here.
// Keeping it empty intentionally blocks login until a real client is registered.
MAPMORY_GOOGLE_IOS_CLIENT_ID_PREFIX =
MAPMORY_GOOGLE_IOS_CLIENT_ID = $(MAPMORY_GOOGLE_IOS_CLIENT_ID_PREFIX).apps.googleusercontent.com
MAPMORY_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.$(MAPMORY_GOOGLE_IOS_CLIENT_ID_PREFIX)

// Internal uses com.mapmory.ios.internal and needs its own iOS OAuth client.
MAPMORY_GOOGLE_INTERNAL_IOS_CLIENT_ID_PREFIX =
MAPMORY_GOOGLE_INTERNAL_IOS_CLIENT_ID = $(MAPMORY_GOOGLE_INTERNAL_IOS_CLIENT_ID_PREFIX).apps.googleusercontent.com
MAPMORY_GOOGLE_INTERNAL_REVERSED_CLIENT_ID = com.googleusercontent.apps.$(MAPMORY_GOOGLE_INTERNAL_IOS_CLIENT_ID_PREFIX)
